# .env.example – примеры переменных окружения (НИЧЕГО не коммитить с реальными ключами)
# DB / Supabase
SUPABASE_URL="https://<your-supabase>.supabase.co"
SUPABASE_SERVICE_KEY="" # сервисный ключ — НЕ хранить в репозитории в реальном виде

# App / Server
NODE_ENV=production
PORT=3003
WS_PORT=3004

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Trading defaults
MIN_VOLUME_USD=20000000    # 20M minimum 24h volume default
DEFAULT_LEVERAGE=10
ORDER_TIMEOUT_S=60         # default order timeout in seconds
SL_PERCENT=1.0
TP_PERCENT=0.5
TEST_MODE=true